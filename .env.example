# Copiá este archivo a .env.local para desarrollo. En Vercel, cargá las mismas
# variables en Settings → Environment Variables.
#
# Sin ninguna variable, `npm run dev` igual funciona: usa un narrador simulado
# y guarda las partidas en memoria.

# ── Gemini (solo servidor; nunca llega al navegador) ─────────────────────────
# Clave de https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Nombre del modelo Flash a usar.
GEMINI_MODEL=gemini-3.8-flash
# Opcional: otro modelo para cuando el principal se queda sin cuota o está
# saturado (por ejemplo, un Flash-Lite, que en el plan gratis tiene más margen).
GEMINI_MODEL_RESPALDO=
# Opcional: MINIMAL, LOW, MEDIUM o HIGH. Bajarlo acorta la espera antes de que
# empiece la narración. Dejalo vacío si tu modelo no admite niveles.
GEMINI_THINKING_LEVEL=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Públicas: el navegador las usa solo para escuchar el canal de la sala.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secreta (solo servidor): Project Settings → API Keys → secret key.
SUPABASE_SECRET_KEY=
